{
  "name": "jide-nova-core",
  "version": "0.2.0",
  "private": true,
  "description": "JIDE NOVA CORE - Nexo inventory interface and authentication API",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.cjs",
    "dev": "node --env-file-if-exists=.env --watch server.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-nexo \"npm test\"",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.cjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.2.0",
    "google-auth-library": "^10.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.30.2"
  }
}
