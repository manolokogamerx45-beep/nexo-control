# Copia este archivo a .env. Nunca subas .env a GitHub.
PORT=4173
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:4173
NODE_ENV=development

# Cloud Firestore de Firebase: base online, no requiere SQL ni proxy.
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_NAMESPACE=nexo
# Credenciales del servidor fuera del repositorio; no usar la API key del navegador.
# ADC (gcloud auth application-default login) o archivo de cuenta de servicio.
# La identidad necesita acceso IAM a Firestore, por ejemplo Cloud Datastore User.
# En Windows usa barras /; Docker monta el archivo como secreto de solo lectura.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/TU_USUARIO/AppData/Roaming/gcloud/application_default_credentials.json
WEB_PORT=4173

# Cliente OAuth de tipo Aplicacion web en Google Cloud.
# URI de redireccion local: http://127.0.0.1:4173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Solo para npm run admin:create; quitar después de crear el administrador.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
